<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,user-scalable=no">
<title>3D Car Racing</title>

<style>
*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  touch-action:none;
}

body{
  overflow:hidden;
  background:#111;
  font-family:Arial,sans-serif;
}

#game{
  position:relative;
  width:100vw;
  height:100vh;
  overflow:hidden;
  background:linear-gradient(#55b8ff 0%,#bdeaff 48%,#27752b 49%,#164d19 100%);
}

#road{
  position:absolute;
  left:50%;
  top:0;
  width:75%;
  height:100%;
  transform:translateX(-50%);
  background:#444;
  border-left:7px solid white;
  border-right:7px solid white;
  overflow:hidden;
}

.line{
  position:absolute;
  left:50%;
  width:12px;
  height:90px;
  background:white;
  transform:translateX(-50%);
}

#car{
  position:absolute;
  width:70px;
  height:120px;
  bottom:45px;
  left:50%;
  transform:translateX(-50%);
  background:#e60000;
  border-radius:18px 18px 10px 10px;
  box-shadow:0 5px 15px #000;
  z-index:5;
}

#car:before{
  content:"";
  position:absolute;
  top:15px;
  left:10px;
  width:50px;
  height:38px;
  background:#9ee8ff;
  border-radius:10px;
}

#car:after{
  content:"";
  position:absolute;
  bottom:10px;
  left:8px;
  width:54px;
  height:25px;
  background:#222;
  border-radius:8px;
}

.enemy{
  position:absolute;
  width:65px;
  height:110px;
  background:#ffd000;
  border-radius:15px;
  box-shadow:0 5px 12px #000;
  z-index:4;
}

.enemy:before{
  content:"";
  position:absolute;
  top:13px;
  left:9px;
  width:47px;
  height:35px;
  background:#b8ecff;
  border-radius:8px;
}

#score{
  position:absolute;
  top:15px;
  left:15px;
  color:white;
  font-size:24px;
  font-weight:bold;
  z-index:10;
  text-shadow:2px 2px 3px #000;
}

#start{
  position:absolute;
  top:50%;
  left:50%;
  transform:translate(-50%,-50%);
  padding:18px 35px;
  font-size:24px;
  border:0;
  border-radius:15px;
  background:#00c853;
  color:white;
  font-weight:bold;
  z-index:20;
}

.controls{
  position:absolute;
  bottom:15px;
  left:0;
  width:100%;
  display:flex;
  justify-content:space-around;
  z-index:15;
}

.controls button{
  width:90px;
  height:65px;
  border:0;
  border-radius:20px;
  background:#ffffffcc;
  font-size:35px;
  font-weight:bold;
}
</style>
</head>

<body>

<div id="game">

  <div id="score">Score: 0</div>

  <div id="road">
    <div class="line" style="top:0"></div>
    <div class="line" style="top:180px"></div>
    <div class="line" style="top:360px"></div>
    <div class="line" style="top:540px"></div>

    <div id="car"></div>
  </div>

  <button id="start">START GAME</button>

  <div class="controls">
    <button id="left">◀</button>
    <button id="right">▶</button>
  </div>

</div>

<script>

const car = document.getElementById("car");
const road = document.getElementById("road");
const start = document.getElementById("start");
const scoreText = document.getElementById("score");

let carX = 50;
let score = 0;
let running = false;
let enemies = [];

function moveCar(dir){
  if(!running) return;

  carX += dir * 5;

  if(carX < 10) carX = 10;
  if(carX > 90) carX = 90;

  car.style.left = carX + "%";
}

document.getElementById("left").addEventListener("touchstart",()=>{
  moveCar(-1);
});

document.getElementById("right").addEventListener("touchstart",()=>{
  moveCar(1);
});

document.addEventListener("keydown",(e)=>{
  if(e.key==="ArrowLeft") moveCar(-1);
  if(e.key==="ArrowRight") moveCar(1);
});

function createEnemy(){

  const enemy = document.createElement("div");
  enemy.className="enemy";

  enemy.style.left =
    (10 + Math.random()*80) + "%";

  enemy.style.top="-130px";

  road.appendChild(enemy);

  enemies.push({
    el:enemy,
    y:-130
  });
}

function gameLoop(){

  if(!running) return;

  enemies.forEach((enemy,index)=>{

    enemy.y += 7;
    enemy.el.style.top=enemy.y+"px";

    const carRect=car.getBoundingClientRect();
    const enemyRect=enemy.el.getBoundingClientRect();

    if(
      carRect.left < enemyRect.right &&
      carRect.right > enemyRect.left &&
      carRect.top < enemyRect.bottom &&
      carRect.bottom > enemyRect.top
    ){
      gameOver();
    }

    if(enemy.y > window.innerHeight){

      enemy.el.remove();
      enemies.splice(index,1);

      score++;
      scoreText.innerText="Score: "+score;
    }

  });

  requestAnimationFrame(gameLoop);
}

function gameOver(){

  running=false;

  alert("Game Over! Score: "+score);

  location.reload();
}

start.addEventListener("click",()=>{

  start.style.display="none";
  running=true;

  setInterval(()=>{
    if(running) createEnemy();
  },1200);

  gameLoop();
});

</script>

</body>
</html>
